{
    "name": "automation-tests",
    "license": "UNLICENSED",
    "devDependencies": {
        "cypress": "^4.12.1"
    },
    "scripts": {
        "open": "cypress open  ./cypress",
        "run": "cypress run  ./cypress",
        "test": "yarn api-tests && yarn desktop-tests && yarn mobile-tests",
        "api-tests": "yarn run run --spec './cypress/integration/api/*.js' --browser chrome",
        "desktop-tests": "yarn run run --spec './cypress/integration/web/*.js' --browser chrome",
        "mobile-tests": "yarn run run --spec './cypress/integration/mobile/*.js' --browser chrome"
    }
}
